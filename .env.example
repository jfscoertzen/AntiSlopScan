ANTISLOPSCAN_SOURCE=.
ANTISLOPSCAN_CONFIG_FILE=./config/container-default.json
ANTISLOPSCAN_AI_ENABLED=false
ANTISLOPSCAN_AI_PROVIDER=ollama
ANTISLOPSCAN_AI_BASE_URL=http://host.docker.internal:11434
ANTISLOPSCAN_AI_MODEL=configured-model
ANTISLOPSCAN_AI_MODE=architecture
ANTISLOPSCAN_AI_API_KEY_ENV=AUDIT_AI_API_KEY
ANTISLOPSCAN_AI_ALLOW_SOURCE_TRANSMISSION=false
ANTISLOPSCAN_AI_TIMEOUT_SECONDS=180
ANTISLOPSCAN_AI_MAX_SOURCE_BYTES=32768
ANTISLOPSCAN_AI_MAX_FILES=24
# Enable provider egress only deliberately, together with AI and source consent.
ANTISLOPSCAN_NETWORK_INTERNAL=true
