{
  "$schema": "../schemas/audit-config.schema.json",
  "version": "1.0",
  "project": { "name": "antislopscan", "source": ".", "type": "application", "languages": ["auto"] },
  "audit": {
    "exclude": ["**/node_modules/**", "**/dist/**", "**/build/**", "**/coverage/**", "**/vendor/**", "**/artifacts/**", "**/tools/python/**", "**/tools/bin/**", "**/tests/**", "**/*.min.js"],
    "failOnScannerError": true
  },
  "architecture": {
    "boundaries": [
      { "from": "src/analysis/**", "disallow": ["src/server.ts", "src/cli.ts", "src/jobs.ts", "src/history.ts", "src/reports/**"], "reason": "Analysis is independent of transport, persistence, and presentation." },
      { "from": "src/security/**", "disallow": ["src/server.ts", "src/cli.ts", "src/history.ts", "src/jobs.ts"], "reason": "Security primitives do not depend on application entry points." }
    ]
  },
  "reports": { "formats": ["html", "pdf", "json", "sarif"] }
}
