{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://antislopscan.local/schemas/audit-result.schema.json",
  "title": "antislopscan canonical audit result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "applianceVersion",
    "id",
    "startedAt",
    "completedAt",
    "project",
    "configurationHash",
    "inventory",
    "scanners",
    "findings",
    "graph",
    "principles",
    "erosion",
    "scores",
    "ci",
    "reports",
    "limitations"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "applianceVersion": {
      "type": "string",
      "maxLength": 20000
    },
    "id": {
      "type": "string",
      "maxLength": 20000
    },
    "startedAt": {
      "type": "string",
      "maxLength": 20000
    },
    "completedAt": {
      "type": "string",
      "maxLength": 20000
    },
    "project": {
      "type": "object",
      "required": [
        "name",
        "source",
        "identity"
      ],
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 20000
        },
        "source": {
          "type": "string",
          "maxLength": 20000
        },
        "identity": {
          "type": "string",
          "maxLength": 20000
        }
      }
    },
    "configurationHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "inventory": {
      "type": "object",
      "required": [
        "files",
        "languages",
        "totalBytes",
        "totalLines",
        "dependencies",
        "documents"
      ],
      "properties": {
        "files": {
          "type": "array",
          "maxItems": 50000,
          "items": {
            "type": "object",
            "required": [
              "path",
              "language",
              "bytes",
              "lines",
              "hash"
            ],
            "properties": {
              "path": {
                "type": "string",
                "maxLength": 20000
              },
              "language": {
                "type": "string",
                "maxLength": 20000
              },
              "bytes": {
                "type": "number",
                "minimum": 0
              },
              "lines": {
                "type": "number",
                "minimum": 0
              },
              "hash": {
                "type": "string",
                "maxLength": 20000
              }
            }
          }
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 20000
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 20000
          }
        },
        "documents": {
          "type": "array"
        },
        "totalBytes": {
          "type": "number",
          "minimum": 0
        },
        "totalLines": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "scanners": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "version",
          "status",
          "durationMs",
          "findings",
          "analyzedFiles"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 20000
          },
          "name": {
            "type": "string",
            "maxLength": 20000
          },
          "version": {
            "type": "string",
            "maxLength": 20000
          },
          "status": {
            "enum": [
              "completed",
              "failed",
              "timed_out",
              "skipped",
              "unavailable",
              "unsupported"
            ]
          },
          "durationMs": {
            "type": "number",
            "minimum": 0
          },
          "analyzedFiles": {
            "type": "number",
            "minimum": 0
          },
          "findings": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "ruleId",
                "scanner",
                "category",
                "severity",
                "assessment",
                "method",
                "confidence",
                "file",
                "line",
                "column",
                "message",
                "evidence",
                "recommendation",
                "principles",
                "fingerprint",
                "sources"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "maxLength": 20000
                },
                "ruleId": {
                  "type": "string",
                  "maxLength": 20000
                },
                "scanner": {
                  "type": "string",
                  "maxLength": 20000
                },
                "category": {
                  "enum": [
                    "slop",
                    "codeQuality",
                    "architecture",
                    "systemsThinking",
                    "security",
                    "maintainability",
                    "technicalDebt"
                  ]
                },
                "severity": {
                  "enum": [
                    "critical",
                    "major",
                    "minor",
                    "info"
                  ]
                },
                "assessment": {
                  "enum": [
                    "verified_violation",
                    "strong_evidence",
                    "potential_risk",
                    "informational",
                    "not_assessable",
                    "not_applicable"
                  ]
                },
                "method": {
                  "enum": [
                    "deterministic",
                    "heuristic",
                    "ai_assisted"
                  ]
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "file": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096,
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
                },
                "line": {
                  "type": "integer",
                  "minimum": 1
                },
                "column": {
                  "type": "integer",
                  "minimum": 1
                },
                "message": {
                  "type": "string",
                  "maxLength": 20000
                },
                "evidence": {
                  "type": "string",
                  "maxLength": 20000
                },
                "recommendation": {
                  "type": "string",
                  "maxLength": 20000
                },
                "principles": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 20000
                  }
                },
                "sources": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 20000
                  }
                },
                "fingerprint": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "snippet": {
                  "type": "string",
                  "maxLength": 20000
                }
              }
            }
          },
          "message": {
            "type": "string",
            "maxLength": 20000
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "ruleId",
          "scanner",
          "category",
          "severity",
          "assessment",
          "method",
          "confidence",
          "file",
          "line",
          "column",
          "message",
          "evidence",
          "recommendation",
          "principles",
          "fingerprint",
          "sources"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 20000
          },
          "ruleId": {
            "type": "string",
            "maxLength": 20000
          },
          "scanner": {
            "type": "string",
            "maxLength": 20000
          },
          "category": {
            "enum": [
              "slop",
              "codeQuality",
              "architecture",
              "systemsThinking",
              "security",
              "maintainability",
              "technicalDebt"
            ]
          },
          "severity": {
            "enum": [
              "critical",
              "major",
              "minor",
              "info"
            ]
          },
          "assessment": {
            "enum": [
              "verified_violation",
              "strong_evidence",
              "potential_risk",
              "informational",
              "not_assessable",
              "not_applicable"
            ]
          },
          "method": {
            "enum": [
              "deterministic",
              "heuristic",
              "ai_assisted"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "file": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "column": {
            "type": "integer",
            "minimum": 1
          },
          "message": {
            "type": "string",
            "maxLength": 20000
          },
          "evidence": {
            "type": "string",
            "maxLength": 20000
          },
          "recommendation": {
            "type": "string",
            "maxLength": 20000
          },
          "principles": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 20000
            }
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 20000
            }
          },
          "fingerprint": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "snippet": {
            "type": "string",
            "maxLength": 20000
          }
        }
      }
    },
    "aiArchitecture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "provider",
        "model",
        "baseUrl",
        "rubricVersion",
        "completedAt",
        "score",
        "assessedPrinciples",
        "requestedPrinciples",
        "sampledFiles",
        "totalFiles",
        "sampledBytes",
        "totalSourceBytes",
        "sampledDocuments",
        "formula",
        "limitations",
        "principles",
        "errors"
      ],
      "properties": {
        "status": {
          "enum": [
            "completed",
            "partial"
          ]
        },
        "provider": {
          "enum": [
            "ollama",
            "openai",
            "claude",
            "openrouter",
            "openai-compatible"
          ]
        },
        "model": {
          "type": "string",
          "maxLength": 20000
        },
        "baseUrl": {
          "type": "string",
          "maxLength": 20000
        },
        "rubricVersion": {
          "const": "1.0"
        },
        "completedAt": {
          "type": "string",
          "maxLength": 20000
        },
        "score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "assessedPrinciples": {
          "type": "number",
          "minimum": 0
        },
        "requestedPrinciples": {
          "type": "number",
          "minimum": 0
        },
        "sampledFiles": {
          "type": "number",
          "minimum": 0
        },
        "totalFiles": {
          "type": "number",
          "minimum": 0
        },
        "sampledBytes": {
          "type": "number",
          "minimum": 0
        },
        "totalSourceBytes": {
          "type": "number",
          "minimum": 0
        },
        "sampledDocuments": {
          "type": "number",
          "minimum": 0
        },
        "formula": {
          "type": "string",
          "maxLength": 20000
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 20000
          }
        },
        "principles": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "principleId",
              "assessment",
              "score",
              "confidence",
              "reasoning",
              "recommendation",
              "evidence"
            ],
            "properties": {
              "principleId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "assessment": {
                "enum": [
                  "supported",
                  "potential_risk",
                  "violation",
                  "not_assessable",
                  "not_applicable"
                ]
              },
              "score": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 100
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "reasoning": {
                "type": "string",
                "minLength": 5,
                "maxLength": 2000
              },
              "recommendation": {
                "type": "string",
                "minLength": 5,
                "maxLength": 2000
              },
              "evidence": {
                "type": "array",
                "maxItems": 3,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "file",
                    "line",
                    "endLine",
                    "quote"
                  ],
                  "properties": {
                    "file": {
                      "type": "string",
                      "maxLength": 4096
                    },
                    "line": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "endLine": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "quote": {
                      "type": "string",
                      "minLength": 8,
                      "maxLength": 500
                    }
                  }
                }
              }
            }
          }
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 20000
          }
        }
      }
    },
    "graph": {
      "type": "object",
      "required": [
        "nodes",
        "edges",
        "cycles",
        "unresolvedImports"
      ],
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "file",
              "fanIn",
              "fanOut",
              "lines",
              "complexity"
            ],
            "properties": {
              "file": {
                "type": "string",
                "maxLength": 20000
              },
              "fanIn": {
                "type": "number",
                "minimum": 0
              },
              "fanOut": {
                "type": "number",
                "minimum": 0
              },
              "lines": {
                "type": "number",
                "minimum": 0
              },
              "complexity": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "from",
              "to",
              "line",
              "typeOnly"
            ],
            "properties": {
              "from": {
                "type": "string",
                "maxLength": 20000
              },
              "to": {
                "type": "string",
                "maxLength": 20000
              },
              "line": {
                "type": "number",
                "minimum": 0
              },
              "typeOnly": {
                "type": "boolean"
              }
            }
          }
        },
        "cycles": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 20000
            }
          }
        },
        "unresolvedImports": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "principles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "languages",
          "methodology",
          "requiredEvidence",
          "severity",
          "confidence",
          "scoreImpact",
          "recommendation",
          "falsePositives",
          "assessment",
          "findings"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 20000
          },
          "name": {
            "type": "string",
            "maxLength": 20000
          },
          "description": {
            "type": "string",
            "maxLength": 20000
          },
          "languages": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 20000
            }
          },
          "methodology": {
            "type": "string",
            "maxLength": 20000
          },
          "requiredEvidence": {
            "type": "string",
            "maxLength": 20000
          },
          "severity": {
            "type": "string",
            "maxLength": 20000
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "scoreImpact": {
            "type": "string",
            "maxLength": 20000
          },
          "recommendation": {
            "type": "string",
            "maxLength": 20000
          },
          "falsePositives": {
            "type": "string",
            "maxLength": 20000
          },
          "assessment": {
            "type": "string",
            "maxLength": 20000
          },
          "findings": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 20000
            }
          }
        }
      }
    },
    "erosion": {
      "type": "object",
      "required": [
        "basis",
        "score",
        "comparable",
        "explanation",
        "measurements",
        "deltas"
      ],
      "properties": {
        "basis": {
          "enum": [
            "current_structural_risk",
            "historical_comparison"
          ]
        },
        "score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "comparable": {
          "type": "boolean"
        },
        "baselineId": {
          "type": "string",
          "maxLength": 20000
        },
        "explanation": {
          "type": "string",
          "maxLength": 20000
        },
        "measurements": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "deltas": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        }
      }
    },
    "scores": {
      "type": "object",
      "required": [
        "overall",
        "categories",
        "coverage",
        "confidence",
        "formula",
        "penalties"
      ],
      "properties": {
        "overall": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "categories": {
          "type": "object",
          "required": [
            "slop",
            "codeQuality",
            "architecture",
            "systemsThinking",
            "security",
            "maintainability",
            "technicalDebt"
          ],
          "additionalProperties": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 100
          }
        },
        "coverage": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "formula": {
          "type": "string",
          "maxLength": 20000
        },
        "penalties": {
          "type": "object",
          "required": [
            "slop",
            "codeQuality",
            "architecture",
            "systemsThinking",
            "security",
            "maintainability",
            "technicalDebt"
          ],
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "ci": {
      "type": "object",
      "required": [
        "passed",
        "exitCode",
        "reasons",
        "newHighSeverity"
      ],
      "properties": {
        "passed": {
          "type": "boolean"
        },
        "exitCode": {
          "type": "integer",
          "minimum": 0,
          "maximum": 125
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 20000
          }
        },
        "newHighSeverity": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "reports": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "format",
          "status"
        ],
        "properties": {
          "format": {
            "enum": [
              "html",
              "pdf",
              "json",
              "sarif"
            ]
          },
          "status": {
            "enum": [
              "completed",
              "failed"
            ]
          },
          "file": {
            "type": "string",
            "maxLength": 20000
          },
          "message": {
            "type": "string",
            "maxLength": 20000
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 20000
      }
    }
  }
}
